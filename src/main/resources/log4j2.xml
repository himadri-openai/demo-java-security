<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{ISO8601} %-5p %c{1.} - %m%n">
        <RegexReplacement
          regex="(?i)(authorization|cookie|set-cookie)=([^\s,;]+)"
          replacement="$1=***" />
        <RegexReplacement
          regex="(?i)(password|secret|token|apiKey)=([^\s,;]+)"
          replacement="$1=***" />
        <RegexReplacement
          regex="(?i)(\"(authorization|cookie|set-cookie|password|secret|token|apiKey)\"\s*:\s*\")([^\"]+)(\")"
          replacement="\"$2\":\"***\"" />
      </PatternLayout>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="Console" />
    </Root>
  </Loggers>
</Configuration>
